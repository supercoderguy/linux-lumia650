# Lumia 650 additions on top of msm8916_defconfig (32-bit ARM).
# Boot path: BootShim -> Lumia650Pkg UEFI -> Linux EFI stub (zImage).
CONFIG_EFI=y
# Lets the UEFI shell pass the device tree as dtb=\path\to.dtb
CONFIG_EFI_ARMSTUB_DTB_LOADER=y
# USB gadget for the debug initramfs: NCM network + ACM serial over configfs
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
# Debugging the storage hang: load sdhci-msm by hand from the initramfs shell,
# and report stuck tasks / CPUs on the console.
CONFIG_MMC_SDHCI_MSM=m
CONFIG_DEBUG_KERNEL=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=20
CONFIG_SOFTLOCKUP_DETECTOR=y
# CPU idle power collapse (SPM + TrustZone) froze the phone at the first
# long sleep (boot 11); keep the CPUs in plain WFI for now.
# CONFIG_CPU_IDLE is not set
